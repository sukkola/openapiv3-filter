---
source: crates/cli/tests/file_filtering_test.rs
expression: result.trim_end()
---
openapi: 3.1.0
info:
  title: Full Coverage API
  version: 1.0.0
  summary: A short summary of this API
paths: {}
webhooks:
  userCreated:
    post:
      tags:
      - users
      - items
      summary: User created event
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/UserEvent'
      responses:
        '200':
          description: Webhook received
  userDeleted:
    post:
      tags:
      - users
      security:
      - ApiKeyAuth: []
      summary: User deleted event
      responses:
        '200':
          description: Webhook received
components:
  schemas:
    UserEvent:
      type: object
      properties:
        event:
          type: string
  securitySchemes:
    ApiKeyAuth:
      type: apiKey
      in: header
      name: X-API-Key
