                "message": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  },
  "paths": {
    "/users/{userId}": {
      "get": {
        "tags": [
          "item"
        ],
        "summary": "Get user by ID",
        "parameters": [
